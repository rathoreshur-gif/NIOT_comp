<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Task 5 octagon pickup: capsule. See rs2026_pickup_bandaid/model.sdf for
       why the roll, the offset and the mesh scale are baked in.

       This prop is 0.140 m across in CAD rather than 0.168, so it takes its own
       scale to land on the same 0.070 m grasp width: 0.070 / 0.140 = 0.5.

       Mesh AABB after the roll and scale: 0.0700 x 0.0700 x 0.0500 m. -->
  <model name="rs2026_pickup_capsule">
    <link name="pickup_link">
      <inertial>
        <!-- 1200 kg/m^3 over the collision box; see rs2026_pickup_bandaid. -->
        <mass>0.2940</mass>
        <inertia>
          <ixx>0.000181</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000181</iyy><iyz>0</iyz>
          <izz>0.000240</izz>
        </inertia>
      </inertial>

      <!-- Box rather than the mesh, matching test_box and the other three pickups.
           A <mesh> collision here needs the same pose the visual carries to cancel
           the mesh's baked-in CAD offset and roll; without one the physics body
           lands ~0.19 m from where the prop is drawn and un-rolled, so it reads as
           floating and falls straight through the table. Trimesh contact also
           chatters where box-vs-box reports a stable pair of points, and the
           gripper decides it has a grasp from the finger contact sensors. -->
      <collision name="pickup_collision">
        <geometry>
          <box><size>0.0700 0.0700 0.0500</size></box>
        </geometry>
        <surface>
          <contact>
            <ode><kp>500000</kp><kd>200</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode>
          </contact>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>

      <visual name="pickup_visual">
        <pose>-0.085000 0.170000 -0.045000 1.570796 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.500000 0.500000 0.500000</scale>
            <uri>model://rs2026_octogon/meshes/capsule_pickup_obj.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- Water drag. Without this a prop has no damping of any kind: the world's
         graded_buoyancy displaces at 1025 against a prop density of 1200, leaving a
         net 9.81*(1-1025/1200) = 1.43 m/s^2, so a nudged prop coasts and tumbles
         almost indefinitely instead of settling. Only the damping terms are set -
         the added-mass terms are left at zero on purpose, because an added inertia
         at or above this link's own 1.8e-4 is what makes the solver ring.
         Quadratic terms are 0.5*rho*Cd*A with rho=1025, Cd~1.05 for a box:
         0.0035 m^2 broadside -> 1.9, 0.0049 m^2 on the flat -> 2.6. That puts the
         sink rate at about 0.4 m/s, which is what the real prop does. -->
    <plugin filename="ignition-gazebo-hydrodynamics-system"
            name="ignition::gazebo::systems::Hydrodynamics">
      <link_name>pickup_link</link_name>

      <xU>-0.5</xU>
      <yV>-0.5</yV>
      <zW>-0.5</zW>
      <kP>-0.002</kP>
      <mQ>-0.002</mQ>
      <nR>-0.002</nR>

      <xUabsU>-1.9</xUabsU>
      <yVabsV>-1.9</yVabsV>
      <zWabsW>-2.6</zWabsW>
      <kPabsP>-0.005</kPabsP>
      <mQabsQ>-0.005</mQabsQ>
      <nRabsR>-0.005</nRabsR>
    </plugin>

    <!-- The prop's world pose, for octagon_flagger's delivery test. Odometry
         rather than PosePublisher for the same reason payload_torpedo uses it:
         PosePublisher reports a link's pose relative to the model containing
         it, which for a one-link model is a constant zero. The twist matters
         here too - "delivered" means come to REST on a pad, and the flagger
         reads the speed off this message. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>pickup_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
      <publish_tf>false</publish_tf>
    </plugin>
  </model>
</sdf>
