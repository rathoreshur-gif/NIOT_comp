      <!-- Only two textured .dae bins were ever exported, and both carry the
           box_1 geometry, which sits at local Z 0..0.35. box_3 and box_4 are
           the same shape moved along local Z, so the shared visual has to be
           pushed back by that difference or it renders where no collision is -
           the bin looks displaced and a marker aimed at it falls straight
           through. Offsets are the z_min of each box's own collision STL. -->
      <visual name='box_3_visual'>
        <pose>0 0 -0.109776 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://rs2026_bin_urdf/meshes/box_2.dae</uri>
