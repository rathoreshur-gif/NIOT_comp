<?xml version="1.0"?>
<model>
  <name>payload_torpedo</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    A torpedo the AUV carries and fires. Top-level for the same reason
    payload_marker is: only a top-level model can be teleported back into its
    tube, and that teleport is what "press B again to reload" is made of.
  </description>
</model>
