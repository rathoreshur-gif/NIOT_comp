<?xml version="1.0"?>
<model>
  <name>payload_marker</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    A marker the AUV carries and drops. A TOP-LEVEL model, welded to the hull by
    a DetachableJoint declared in the AUV, rather than a model nested inside it.
    That is what makes it reloadable: Gazebo's set_pose refuses nested models
    ("Unable to set world pose for nested models"), so a nested marker could
    never be teleported back into its cradle once dropped.
  </description>
</model>
