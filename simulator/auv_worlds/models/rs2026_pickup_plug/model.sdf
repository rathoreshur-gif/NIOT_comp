<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Task 5 octagon pickup: plug. See rs2026_pickup_bandaid/model.sdf for why
       the roll, the offset and the mesh scale are baked in.

       Mesh AABB after the roll and scale: 0.0700 x 0.0700 x 0.0250 m. -->
  <model name="rs2026_pickup_plug">
    <link name="pickup_link">
      <inertial>
        <!-- 1200 kg/m^3 over the collision box; see rs2026_pickup_bandaid. -->
        <mass>0.1470</mass>
        <inertia>
          <ixx>0.000068</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000068</iyy><iyz>0</iyz>
          <izz>0.000120</izz>
        </inertia>
      </inertial>

      <collision name="pickup_collision">
        <geometry>
          <box><size>0.0700 0.0700 0.0250</size></box>
        </geometry>
        <surface>
          <contact>
            <ode><kp>500000</kp><kd>200</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode>
          </contact>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>

      <visual name="pickup_visual">
        <pose>-0.134708 -0.040167 -0.031000 1.570796 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.416667 0.416667 0.416667</scale>
            <uri>model://rs2026_octogon/meshes/plug_pickup_obj.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- Water drag; see rs2026_pickup_capsule/model.sdf for the derivation and for
         why the added-mass terms are deliberately left at zero. Broadside area is
         half the capsule's (0.00175 m^2) because this prop is 0.025 m thick, so the
         in-plane quadratic terms drop to match; the flat face is unchanged. -->
    <plugin filename="ignition-gazebo-hydrodynamics-system"
            name="ignition::gazebo::systems::Hydrodynamics">
      <link_name>pickup_link</link_name>

      <xU>-0.3</xU>
      <yV>-0.3</yV>
      <zW>-0.3</zW>
      <kP>-0.001</kP>
      <mQ>-0.001</mQ>
      <nR>-0.001</nR>

      <xUabsU>-0.95</xUabsU>
      <yVabsV>-0.95</yVabsV>
      <zWabsW>-2.6</zWabsW>
      <kPabsP>-0.003</kPabsP>
      <mQabsQ>-0.003</mQabsQ>
      <nRabsR>-0.003</nRabsR>
    </plugin>
  </model>
</sdf>
