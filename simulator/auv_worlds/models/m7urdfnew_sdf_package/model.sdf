      <sensor name="imu_sensor_1" type="imu">
        <pose>0.5 0.1 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/model/auv/imu_1</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev><bias_mean>0</bias_mean><bias_stddev>0.1</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev><bias_mean>0</bias_mean><bias_stddev>0.1</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev><bias_mean>0</bias_mean><bias_stddev>0.1</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.5</stddev><bias_mean>0</bias_mean><bias_stddev>0.2</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.5</stddev><bias_mean>0</bias_mean><bias_stddev>0.2</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.5</stddev><bias_mean>0</bias_mean><bias_stddev>0.2</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- 700x400 is exactly half of the original 1400x800, so the aspect ratio
           and therefore the vertical FOV are unchanged, and the focal length in
           sim pixels halves exactly (761.24 -> 380.62). simulator_bridge's
           _init_distortion_maps hardcodes both; keep them in step with this. -->
      <sensor name="front_camera" type="rgbd_camera">
        <pose>1.5 0 0.5 0 0 0</pose>
        <topic>/model/auv/front_camera</topic>
        <camera>
          <horizontal_fov>1.487</horizontal_fov>
          <image>
            <width>700</width>
            <height>400</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>30</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>

      <!-- Halved alongside the front camera; f_sim 752.59 -> 376.30. -->
      <sensor name="bottom_camera" type="camera">
        <pose>0 0 -0.3 0 1.5708 0</pose>
        <topic>/model/auv/bottom_camera/image</topic>
        <camera>
          <horizontal_fov>1.500</horizontal_fov>
          <image>
            <width>700</width>
            <height>400</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>50</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>


    <plugin filename="ignition-gazebo-hydrodynamics-system"
            name="ignition::gazebo::systems::Hydrodynamics">
      <link_name>base_link</link_name>

      <xDotU>-0.196</xDotU>
      <yDotV>-9.31</yDotV>
      <zDotW>-9.31</zDotW>
      <kDotP>-0.1</kDotP>
      <mDotQ>-1.84</mDotQ>
      <nDotR>-1.84</nDotR>

      <xU>-130.7</xU>
      <yV>-116.0</yV>
      <zW>-116.0</zW>
      <kP>-9.5</kP>
      <mQ>-9.50</mQ>
      <nR>-9.50</nR>

      <xUabsU>-14.5</xUabsU>
      <yVabsV>-216.0</yVabsV>
      <zWabsW>-350.0</zWabsW>
      <kPabsP>-2.0  </kPabsP>
      <mQabsQ>-18.0</mQabsQ>
      <nRabsR>-18.0</nRabsR>

    </plugin>


    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <link_name>base_link</link_name>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
      <frame_id>world</frame_id>
    </plugin>


    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <degrees>true</degrees>
      <publish_odometry>true</publish_odometry>
      <publish_tf>true</publish_tf>
      <update_frequency>20</update_frequency>
    </plugin>


    <link name="surge_front_left_link">
      <pose>0.402 -0.244 0.0 0.0 0.0 0.785</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
      </inertial>
    </link>
    <joint name="surge_front_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>surge_front_left_link</child>
      <axis>
        <xyz expressed_in="__model__">0.707 -0.707 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
