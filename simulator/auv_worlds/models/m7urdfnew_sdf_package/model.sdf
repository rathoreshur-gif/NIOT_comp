<?xml version="1.0"?>
<sdf version="1.8">
  <model name="m7urdfnew_sdf_package">

    <link name="base_link">

      <inertial>
        <mass>40.81837758</mass>
        <inertia>
          <ixx>1000</ixx>  <ixy>0</ixy>  <ixz>0</ixz>
          <iyy>1000</iyy>   <iyz>0</iyz>
          <izz>7.90</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box><size>1.5 0.1665 0.1665</size></box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1000000</kp><kd>100</kd>
              <max_vel>0.5</max_vel><min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction><ode><mu>0.1</mu><mu2>0.1</mu2></ode></friction>
        </surface>
      </collision>

      <!-- Scoring: hull contacts against anything at all. Reports the pool
           floor and walls too, so consumers filter by the other collision's
           model name. This is the sensor to use for props there are too many
           of to instrument individually, such as the nine slalom poles. -->
      <sensor name="hull_contact_sensor" type="contact">
        <update_rate>30.0</update_rate>
        <always_on>true</always_on>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>

