    <!-- NEW FINGER LINKS AND JOINTS ADDED HERE -->
    <link name="left_finger_link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="left_finger_visual">
        <pose>-0.3918 0.0667 -0.41806 1.5932 0.16115 -1.56719</pose>
        <geometry>
          <mesh>
            <uri>model://m7urdfnew_sdf_package/meshes/fingre blue left.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.04 0.61 0.92 1</ambient>
          <diffuse>0.04 0.61 0.92 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="left_finger_collision">
        <pose>-0.3918 0.0667 -0.41806 1.5932 0.16115 -1.56719</pose>
        <geometry>
          <mesh>
            <uri>model://m7urdfnew_sdf_package/meshes/fingre blue left.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <sensor name="left_finger_contact_sensor" type="contact">
        <update_rate>30.0</update_rate>
        <always_on>true</always_on>
        <contact>
          <collision>left_finger_collision</collision>
        </contact>
      </sensor>
    </link>

    <joint name="left_finger_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_finger_link</child>
      <!-- Adjust this pose to accurately reflect the mechanical pivot point -->
      <pose>-0.4021 0.1000 -0.2831 0 0 0</pose> 
      <axis>
        <xyz>1 0 0</xyz> 
        <limit>
          <lower>-0.5</lower>
          <upper>0.0</upper>
          <effort>10.0</effort>
          <velocity>1.0</velocity>
        </limit>
      </axis>
    </joint>

    <link name="right_finger_link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="right_finger_visual">
        <pose>-0.3918 0.0667 -0.41806 1.5932 0.16115 -1.56719</pose>
        <geometry>
          <mesh>
            <uri>model://m7urdfnew_sdf_package/meshes/fingre blue right.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.04 0.61 0.92 1</ambient>
          <diffuse>0.04 0.61 0.92 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="right_finger_collision">
        <pose>-0.3918 0.0667 -0.41806 1.5932 0.16115 -1.56719</pose>
        <geometry>
          <mesh>
            <uri>model://m7urdfnew_sdf_package/meshes/fingre blue right.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <sensor name="right_finger_contact_sensor" type="contact">
        <update_rate>30.0</update_rate> <!-- Checks 30 times a second -->
        <always_on>true</always_on>
        <contact>
          <collision>right_finger_collision</collision>
        </contact>
      </sensor>
    </link>

    <joint name="right_finger_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_finger_link</child>
      <!-- Adjust this pose to accurately reflect the mechanical pivot point -->
      <pose>-0.4021 -0.0667 -0.2831 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>0.5</upper>
          <effort>10.0</effort>
          <velocity>1.0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- Gripper payload attachment.
         gz-sim 8 (Harmonic) has no <suppress_initial_attach>, so this joint is welded
         the instant the world loads. simulator_bridge publishes on the detach topic at
         startup to release it, then re-attaches on the attach topic once both finger
         contact sensors report the same object. Re-attach welds at the object's
         *current* pose relative to base_link, which is exactly the grasp pose.
         One plugin instance is needed per graspable object, so there is one per Task 5
         pickup below. Worlds that do not contain a given model simply never attach it
         (suppress_child_warning keeps them quiet), which is what lets test_matsya.sdf
         still work - it carries test_box and none of these.

         Every name here is load-bearing three ways over: <child_model> must equal the
         prop name in competition_config.yaml, and the topic must match both the gz side
         of bridge_topics_thrusters.yaml and the key simulator_bridge builds its
         publishers from. Rename in one place and you must rename in all four. -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>test_box</child_model>
      <child_link>box_link</child_link>
      <detach_topic>/model/auv/joint/gripper_test_box_joint/detach</detach_topic>
      <attach_topic>/model/auv/joint/gripper_test_box_joint/attach</attach_topic>
      <output_topic>/model/auv/joint/gripper_test_box_joint/state</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>

    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>pickup_bandaid</child_model>
      <child_link>pickup_link</child_link>
      <detach_topic>/model/auv/joint/gripper_pickup_bandaid_joint/detach</detach_topic>
      <attach_topic>/model/auv/joint/gripper_pickup_bandaid_joint/attach</attach_topic>
      <output_topic>/model/auv/joint/gripper_pickup_bandaid_joint/state</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>

    <plugin filename="gz-sim-detachable-joint-system"
