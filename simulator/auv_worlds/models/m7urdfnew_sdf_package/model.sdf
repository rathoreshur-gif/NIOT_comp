    <model name="marker_left">
      <pose>0.0 0.12 -0.10 0 0 0</pose>
      <link name="marker_left_link">
        <inertial>
          <mass>0.001</mass>
          <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="marker_left_collision">
          <pose>-0.6538 1.2814 -0.8547 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://marker/meshes/base_link.STL</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="marker_left_visual">
          <pose>-0.6538 1.2814 -0.8547 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://marker/meshes/base_link.STL</uri>
              <scale>1 1 1</scale>
            </mesh>
