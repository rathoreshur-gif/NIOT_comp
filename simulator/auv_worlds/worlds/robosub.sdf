  <!-- ============================================================
       TASK 3 — BINS (Recon)                      X = 17.0
       Anchored to pool floor (Z = -3). Right side of pool.
       ============================================================ -->
  <include>
    <uri>model://rs2026_bin_urdf</uri>
    <name>task3_bins</name>
    <!-- Bin mesh local Z starts at 0.893 (not 0). Z=-3.893 places base at floor Z=-3. -->
    <pose>17.0 -5.0 -3.893 0 0 0</pose>
  </include>


  <!-- ============================================================
       TASK 4 — TORPEDOES
       Static, collision-free target board (the AUV fires through the
       openings). The model frame is centred on the visible target and
