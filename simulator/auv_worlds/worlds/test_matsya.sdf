  <!-- <model name="water_surface">
    <static>true</static>
    <pose>0 0 0.3 0 0 0</pose>
    <link name="surface">
      <collision name="collision">
        <geometry>
          <box><size>25 25 0.1</size></box>
        </geometry>
        <surface>
          <contact><ode><kp>500000</kp><kd>200</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model> -->

  <model name="water_surface_texture">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="surface">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <transparency>0.30</transparency>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>25 25</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.30 0.62 0.78 0.70</ambient>
          <diffuse>0.35 0.68 0.82 0.70</diffuse>
          <specular>0.90 0.92 0.95 0.70</specular>
          <pbr>
            <metal>
              <albedo_map>../media/textures/water_water_0051_01.jpg</albedo_map>
              <normal_map>../media/textures/water_normal.png</normal_map>
              <roughness>0.08</roughness>
              <metalness>0.02</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>

  <include>
    <uri>model://m7urdfnew_sdf_package</uri>
    <name>auv</name>
    <pose>-7.980710 -0.000320 -0.5 0 0 0</pose>
  </include>
  <!-- <include>
    <uri>model://rs2026_octogon</uri>
    <name>octagon</name>
    <pose>-7.980710 -0.000320 -2 0 0 0</pose>
  </include> -->
  <model name="test_box">
      <!-- Spawn the box 1 meter in the air so it drops to the floor -->
      <pose>-7 0 1.0 0 0 0</pose> 
      
      <link name="box_link">
        <inertial>
          <!-- 0.5 kg to match the inertia tensor below, and so the gripper can
               actually carry it once the DetachableJoint welds it to base_link. -->
          <mass>0.5</mass> <!-- Mass in kg -->
          <inertia>
            <!-- Inertial matrix for a 0.1x0.1x0.1 box weighing 0.5kg -->
            <ixx>0.000833</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.000833</iyy>
            <iyz>0.0</iyz>
            <izz>0.000833</izz>
          </inertia>
        </inertial>
        
        <collision name="box_collision">
          <geometry>
            <box>
              <size>0.07 0.07 0.07</size>
            </box>
          </geometry>
        </collision>
        
        <visual name="box_visual">
          <geometry>
            <box>
              <size>0.07 0.07 0.07</size>
            </box>
          </geometry>
          <material>
            <!-- A nice bright red color to make it easy to spot -->
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>
  <!-- ============================================================
       WATER TINT — the body of water itself.

       Gazebo Harmonic's renderer has no fog. The <fog> block up in
       <scene> is valid SDF but gz-rendering 8 never reads it - there
       is not one fog symbol in the library - which is why the pool
       volume used to look exactly like the air above it.

       So the water gets drawn: one double-sided translucent box
       filling the pool interior. From the deck the pool now reads as
       full; from inside it tints the walls, floor and surface beyond
       it. Visual only - no collision, no shadow - and inset 3 cm from
       every surface so no two faces end up coplanar and z-fighting.

       This is a flat tint, not distance haze: real depth attenuation
       needs stacked translucent slices, which cost fill rate on every
       AUV camera. Raise <transparency> toward 1.0 for clearer water,
       lower it for murkier.
       ============================================================ -->
  <model name="water_tint">
    <static>true</static>
    <pose>0 0 -1.5 0 0 0</pose>
    <link name="volume">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <transparency>0.62</transparency>
        <geometry><box><size>24.74 24.74 2.94</size></box></geometry>
        <material>
          <double_sided>true</double_sided>
          <lighting>false</lighting>
          <ambient>0.05 0.34 0.40 1</ambient>
          <diffuse>0.05 0.34 0.40 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
    </link>
  </model>

</world>
</sdf>