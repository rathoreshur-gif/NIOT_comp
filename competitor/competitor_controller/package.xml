<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>competitor_controller</name>
  <version>0.1.0</version>
  <description>
    Reference controller for the Matsya AUV competition. Runs in the competitor
    container on ROS_DOMAIN_ID=1 and talks to the simulator only through the
    topics listed in Matsya_ROS2_Simulator/docker/domain_bridge.yaml.
  </description>
  <maintainer email="sparshbadjate27@gmail.com">matsya</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>auv_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- std_srvs/Empty: the marker and gripper calls the demo gamepad node makes. -->
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <!-- The controller does its own maths with numpy; declared here because
       rosdep will not infer it from the source. -->
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
